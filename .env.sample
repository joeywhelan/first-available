# Copy to .env and fill in. Never commit .env.

# Google Cloud / AlloyDB
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-east4                 # Must offer AlloyDB c4a-highmem-1 and Vertex AI gemini-embedding-001
ALLOYDB_CLUSTER_ID=summit-demo
ALLOYDB_INSTANCE_ID=summit-demo-primary
DB_NAME=postgres
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-me         # Demo only; avoid '#' (starts a comment)

# Local MCP server (the agent's only way into AlloyDB)
MCP_DB_PASSWORD=change-me           # Password for mcp_search; avoid '#'
MCP_PORT=8000
MCP_AUTH_TOKEN=change-me            # Bearer token Netomi sends; any long random string

# ngrok (publishes the MCP server so Netomi's cloud can reach it)
NGROK_DOMAIN=your-name.ngrok-free.app   # Your account's fixed dev domain (ngrok dashboard), no https://

# Netomi Chat API
NETOMI_AUTH_URL=token-url
NETOMI_CHAT_URL=your-chat-url
NETOMI_INTEGRATION=NETOMI_WEB_WIDGET 
NETOMI_CHANNEL_REF_ID=your-channel-ref-id
NETOMI_VIRTUAL_AGENT_ID=your-virtual-agent-id

# Simulated customer
ANTHROPIC_API_KEY=your-key
CUSTOMER_MODEL=claude-sonnet-5-5
